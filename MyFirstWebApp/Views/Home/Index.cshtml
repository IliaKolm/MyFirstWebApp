@model List<MyFirstWebApp.Data.Car>
@{
    ViewData["Title"] = "Home Page";
}

<table>
    <tr>
        <td>Марка</td>
        <td>Модель</td>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Brand</td>
            <td>@item.Model</td>
        </tr>
    }
</table>

<form method="post">
    <div class="mb-3">
        <label for="exampleInputEmail" class="form-label">Марка</label>
        <input type="text" name="lastName" class="form-cotrol" id="exampleInputEmail" arsia-describedby="emailHelp">
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Модель</label>
        <input type="text" name="firstName" class="form-cotrol" id="exampleInputPassword1">
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>