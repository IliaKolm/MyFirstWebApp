@model List<CarClientApp.Data.Group>
@{
    ViewData["Title"] = "Новое авто";
}

<h2 class="h2">Добавление нового авто</h2>

<form method="post">
    <div class="mb-3">
        <label for="exampleInputEmail" class="form-label">Марка</label>
        <input type="text" name="brand" class="form-cotrol" id="exampleInputEmail" arsia-describedby="emailHelp">
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Модель</label>
        <input type="text" name="model" class="form-cotrol" id="exampleInputPassword1">
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Группа</label>
        <select name="groupId" class="form-cotrol">
            @foreach(var group in Model)
                {
                    <option value="@group.Id">@group.Name</option>
                }
            </select>
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Пароль</label>
        <input type="text" name="password" class="form-cotrol" id="exampleInputPassword1">
    </div>

    <button type="submit" class="btn btn-primary">Добавить</button>
</form>