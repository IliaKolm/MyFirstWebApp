@model CarClientApp.Data.Car

@{
    ViewData["Title"] = "Home Page";
}

<h2 class="h2">Редактирование авто</h2>

<form method="post">
    <div class="mb-3">
        <label for="exampleInputEmail" class="form-label">Марка</label>
        <input type="text" name="brand" class="form-cotrol" id="exampleInputEmail" arsia-describedby="emailHelp" value="@Model?.Brand">
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Модель</label>
        <input type="text" name="model" class="form-cotrol" id="exampleInputPassword1" value="@Model?.Model">
    </div>
    <div class="mb-3">
        <label for="exampleInputPassword1" class="form-label">Пароль</label>
        <input type="text" name="password" class="form-cotrol" id="exampleInputPassword1" value="@Model?.Password">
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>